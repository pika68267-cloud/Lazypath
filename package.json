    "dev": "node --watch lazypath.ts",
    "test": "node test/e2e.mjs && node test/serverless.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}

{
  "name": "lazypath",
  "version": "0.1.0",
  "description": "One endpoint for every LLM. OAuth login, zero API-key setup, automatic fallback.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "lazypath": "lazypath.ts"
  },
  "scripts": {
